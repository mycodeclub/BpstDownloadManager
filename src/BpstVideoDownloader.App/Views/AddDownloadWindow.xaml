<Window x:Class="BpstVideoDownloader.App.Views.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add download" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/velox.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
    <StackPanel Margin="20">
        <TextBlock Text="Address" FontWeight="SemiBold" />
        <TextBox x:Name="UrlBox" Margin="0,6,0,0" TextChanged="UrlBox_TextChanged" />

        <Border x:Name="InfoPanel" Margin="0,14,0,0" Padding="12" CornerRadius="6" Background="#14808080">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="KindBadge" CornerRadius="4" Padding="6,1" Background="#332563EB" Margin="0,0,8,0">
                        <TextBlock x:Name="KindText" FontSize="11" />
                    </Border>
                    <TextBlock x:Name="InfoText" TextWrapping="Wrap" MaxWidth="460" />
                </StackPanel>
                <TextBlock x:Name="DetailText" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Muted}" />
            </StackPanel>
        </Border>

        <Border x:Name="ToolsPanel" Margin="0,10,0,0" Padding="12" CornerRadius="6" Background="#22F59E0B" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Install video tools" Click="InstallTools_Click" Margin="10,0,0,0" />
                <TextBlock x:Name="ToolsText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border x:Name="SignInPanel" Margin="0,10,0,0" Padding="12" CornerRadius="6" Background="#222563EB" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Sign in to YouTube" Click="SignIn_Click" Margin="10,0,0,0" />
                <TextBlock Text="This video needs a signed-in account. Sign in once inside BpstVideoDownloader; your session stays on this PC."
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border x:Name="GrabberPanel" Margin="0,10,0,0" Padding="12" CornerRadius="6" Background="#2214B8A6" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Open in Video Grabber" Click="Grabber_Click" Margin="10,0,0,0" />
                <TextBlock x:Name="GrabberText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="NameLabel" Text="File name" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Grid.Column="1" Grid.ColumnSpan="2" />

            <TextBlock Grid.Row="1" Text="Save to" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox x:Name="FolderBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" />
            <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Margin="8,8,0,0" Click="Browse_Click" />

            <TextBlock x:Name="QualityLabel" Grid.Row="2" Text="Quality" VerticalAlignment="Center" Margin="0,8,0,0" />
            <ComboBox x:Name="QualityBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                      DisplayMemberPath="Label" SelectedValuePath="Id" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="StartButton" Content="Download now" IsDefault="True" MinWidth="120" Click="Start_Click" />
            <Button x:Name="LaterButton" Content="Download later" MinWidth="110" Margin="8,0,0,0" Click="Later_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
