<Window x:Class="BpstVideoDownloader.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:BpstVideoDownloader.Core;assembly=BpstVideoDownloader.Core"
        Title="About BpstVideoDownloader" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/velox.ico" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/Assets/velox.ico" Width="56" Height="56" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static core:Branding.Product}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Text="Free, open-source download manager for Windows: multi-connection downloads, resume, clipboard capture, YouTube and streaming video." />

        <Border Margin="0,18,0,0" Padding="14" CornerRadius="8" Background="#142563EB">
            <StackPanel>
                <TextBlock Style="{StaticResource Muted}" Text="A product of" />
                <TextBlock Text="{x:Static core:Branding.Company}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0">
                    <Run Text="Website: " />
                    <Hyperlink NavigateUri="{x:Static core:Branding.WebsiteUri}" RequestNavigate="Website_Navigate">
                        <Run Text="{x:Static core:Branding.Website}" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,2,0,0">
                    <Run Text="Phone: " /><Run Text="{x:Static core:Branding.Phone}" />
                </TextBlock>
                <TextBlock Margin="0,8,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="Free download and updates are available on our website." />
            </StackPanel>
        </Border>

        <TextBlock Margin="0,16,0,0" FontSize="11" Style="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="MIT License. Video support uses the separate open-source projects yt-dlp, FFmpeg and Deno, each under its own license." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Visit website" MinWidth="110" Click="Visit_Click" />
            <Button Content="Close" IsCancel="True" IsDefault="True" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
