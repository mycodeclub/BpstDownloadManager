<Window x:Class="BpstVideoDownloader.App.Views.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video tools" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/velox.ico" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap">
            Video sites (YouTube and 1000+ others) and HLS/DASH streams are handled by free open-source tools.
            They are downloaded from their official GitHub releases into BpstVideoDownloader's own tools folder.
        </TextBlock>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="yt-dlp (required)" FontWeight="SemiBold" />
                <TextBlock x:Name="YtDlpStatus" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="YtDlpButton" Grid.Column="1" MinWidth="110" VerticalAlignment="Top" Click="YtDlp_Click" />

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="FFmpeg (recommended, ~100 MB): merges HD video + audio, converts to MP3" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="FfmpegStatus" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="FfmpegButton" Grid.Row="1" Grid.Column="1" MinWidth="110" VerticalAlignment="Top" Click="Ffmpeg_Click" />

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="Deno (recommended for YouTube): JavaScript runtime used by yt-dlp" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="DenoStatus" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="DenoButton" Grid.Row="2" Grid.Column="1" MinWidth="110" VerticalAlignment="Top" Click="Deno_Click" />
        </Grid>

        <TextBlock x:Name="Progress" Margin="0,4,0,0" TextWrapping="Wrap" />

        <DockPanel Margin="0,18,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" MinWidth="90" />
            <Button DockPanel.Dock="Left" Content="Open tools folder" Click="OpenFolder_Click" HorizontalAlignment="Left" />
        </DockPanel>
    </StackPanel>
</Window>
