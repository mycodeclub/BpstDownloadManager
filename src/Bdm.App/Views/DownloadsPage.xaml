<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Bdm.App.ViewModels"
             x:Class="Bdm.App.Views.DownloadsPage"
             x:DataType="vm:DownloadsViewModel"
             Title="Downloads"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="{OnIdiom Phone='12,8', Default='20,14'}" RowSpacing="10">

        <!-- Quick add -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Entry x:Name="QuickAddEntry" Placeholder="Paste a link, magnet or video address…"
                   ReturnType="Go" Completed="QuickAdd_Completed" ClearButtonVisibility="WhileEditing" />
            <Button Grid.Column="1" Text="＋ Add" Clicked="Add_Clicked" Style="{StaticResource PrimaryButton}" />
            <Button Grid.Column="2" Text="Torrent file" Clicked="TorrentFile_Clicked" Style="{StaticResource QuietButton}" />
        </Grid>

        <!-- Filters + search -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <CollectionView ItemsSource="{Binding FilterNames}" SelectionMode="Single"
                            SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" HeightRequest="40">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Style="{StaticResource Chip}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <Label Text="{Binding .}" FontSize="13" VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Entry Grid.Column="1" Placeholder="Search" Text="{Binding SearchText}" WidthRequest="{OnIdiom Phone=110, Default=200}" />
        </Grid>

        <!-- Focus banner -->
        <Border Grid.Row="2" IsVisible="{Binding HasFocus}" Style="{StaticResource Banner}" BackgroundColor="#2214B8A6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label Text="{Binding FocusText}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                <Button Grid.Column="1" Text="End focus" Command="{Binding ClearFocusCommand}" Style="{StaticResource QuietButton}" />
            </Grid>
        </Border>

        <!-- Downloads -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="20">
                    <Label Text="⬇" FontSize="44" HorizontalOptions="Center" Opacity="0.5" />
                    <Label Text="Copy or paste any link: files, games, ISOs, YouTube, streaming videos or magnet links."
                           HorizontalTextAlignment="Center" Style="{StaticResource Muted}" />
                    <Label Text="BDM by BitProSoftTech" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" Opacity="0.18" Margin="0,16,0,0" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DownloadItemViewModel">
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                            <Label Grid.RowSpan="2" Text="{Binding KindGlyph}" FontSize="24" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding FileName}" FontAttributes="Bold" LineBreakMode="MiddleTruncation" />
                            <ProgressBar Grid.Column="1" Grid.Row="1" Progress="{Binding Progress}" ProgressColor="{StaticResource Primary}" />
                            <Label Grid.Column="1" Grid.Row="2" Style="{StaticResource Muted}" FontSize="12" LineBreakMode="TailTruncation">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding ProgressText}" FontAttributes="Bold" />
                                        <Span Text="   " />
                                        <Span Text="{Binding SizeText}" />
                                        <Span Text="   " />
                                        <Span Text="{Binding SpeedText}" />
                                        <Span Text="   " />
                                        <Span Text="{Binding StatusText}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Grid Grid.Column="1" Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                <Label Text="{Binding DetailText}" Style="{StaticResource Muted}" FontSize="12" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                <Button Grid.Column="1" Text="{Binding PrimaryActionText}" Style="{StaticResource SmallButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=PrimaryActionCommand, x:DataType=vm:DownloadsViewModel}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="2" Text="⚡ Focus" Style="{StaticResource SmallButton}" IsVisible="{Binding CanFocus}"
                                        ToolTipProperties.Text="Give this download all the bandwidth"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=ToggleFocusCommand, x:DataType=vm:DownloadsViewModel}"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsFocused}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Grid.Column="3" Text="⋯" Style="{StaticResource SmallButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}, Path=MoreCommand, x:DataType=vm:DownloadsViewModel}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Footer -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <Label Text="{Binding SummaryText}" Style="{StaticResource Muted}" FontSize="12" VerticalOptions="Center" />
            <HorizontalStackLayout Grid.Column="1" Spacing="6">
                <Button Text="Start all" Command="{Binding StartAllCommand}" Style="{StaticResource SmallButton}" />
                <Button Text="Pause all" Command="{Binding PauseAllCommand}" Style="{StaticResource SmallButton}" />
            </HorizontalStackLayout>
            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Credit}" Style="{StaticResource Muted}" FontSize="11"
                   HorizontalOptions="{OnIdiom Phone=Start, Default=End}" Margin="0,4,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Credit_Tapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>
    </Grid>
</ContentPage>
