<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bdm.App.Views.FinderPage"
             Title="Smart Finder"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}">
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone=16, Default=24}" Spacing="14" MaximumWidthRequest="860">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Find it legally: games, software, e-books &amp; PDFs, documents, courses, music, movies and web series" FontAttributes="Bold" FontSize="16" LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry x:Name="QueryEntry" Placeholder="e.g. GTA 6 · Die Hard 4 in Hindi · Panchayat web series · video editor · Sherlock Holmes ebook"
                               ReturnType="Search" Completed="Search_Clicked" ClearButtonVisibility="WhileEditing" />
                        <Button x:Name="SearchButton" Grid.Column="1" Text="Search" Clicked="Search_Clicked" Style="{StaticResource PrimaryButton}" />
                    </Grid>
                    <FlexLayout x:Name="CategoryChips" Wrap="Wrap" />
                    <FlexLayout x:Name="LanguageChips" Wrap="Wrap" IsVisible="False" />
                    <FlexLayout x:Name="PriceChips" Wrap="Wrap" />
                    <Label Style="{StaticResource Muted}" FontSize="12" LineBreakMode="WordWrap"
                           Text="Movies and series: the streaming services that have it in your country, where to rent or buy it, and official free streams. Everything else: official stores first, then legal free downloads (open-source release files, free games, public-domain and openly licensed files) and official torrents. Cracks and piracy sites are never shown." />
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout x:Name="BusyRow" Spacing="10" IsVisible="False">
                <ActivityIndicator IsRunning="True" HeightRequest="20" WidthRequest="20" Color="{StaticResource Primary}" />
                <Label x:Name="BusyLabel" Style="{StaticResource Muted}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <VerticalStackLayout x:Name="ResultsHost" Spacing="14" />
            <Label x:Name="CreditsLabel" Style="{StaticResource Muted}" FontSize="11" LineBreakMode="WordWrap" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
