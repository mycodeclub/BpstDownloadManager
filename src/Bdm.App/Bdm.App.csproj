<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Windows + Android today. iOS is ready: build with -p:EnableIos=true on a Mac (or with a paired Mac). -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(EnableIos)' == 'true'">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Bdm.App</RootNamespace>
		<AssemblyName>BDM</AssemblyName>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>BDM</ApplicationTitle>
		<ApplicationId>com.bitprosofttech.bdm</ApplicationId>
		<ApplicationDisplayVersion>2.1.1</ApplicationDisplayVersion>
		<ApplicationVersion>20101</ApplicationVersion>

		<!-- Windows: plain .exe (no MSIX), Windows App SDK and .NET bundled, packaged with Inno Setup. -->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- Android build machine paths (Visual Studio's defaults). Override on the command line if yours differ. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And $([MSBuild]::IsOSPlatform('windows'))">
		<AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' And Exists('C:\Program Files (x86)\Android\android-sdk')">C:\Program Files (x86)\Android\android-sdk</AndroidSdkDirectory>
		<JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' And Exists('C:\Program Files\Android\openjdk\jdk-21.0.8')">C:\Program Files\Android\openjdk\jdk-21.0.8</JavaSdkDirectory>
	</PropertyGroup>

	<!-- Windows release: 64-bit, .NET + Windows App SDK bundled (no runtime install needed on the user's PC). -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
	</PropertyGroup>

	<!-- Release signing: set BDM_KEYSTORE (path) and BDM_KEYSTORE_PASSWORD (env vars). The key is never in the repo. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(Configuration)' == 'Release' And '$(BDM_KEYSTORE)' != ''">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(BDM_KEYSTORE)</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>bdm</AndroidSigningKeyAlias>
		<AndroidSigningStorePass>env:BDM_KEYSTORE_PASSWORD</AndroidSigningStorePass>
		<AndroidSigningKeyPass>env:BDM_KEYSTORE_PASSWORD</AndroidSigningKeyPass>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(Configuration)' == 'Release'">
		<AndroidPackageFormats>apk</AndroidPackageFormats>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1D4ED8" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1D4ED8" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Latest .NET 10 servicing release of MAUI (stable). -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<!-- 16.x is the last line for .NET 10 (17.x requires .NET 11). -->
		<PackageReference Include="CommunityToolkit.Maui" Version="16.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Bdm.Core\Bdm.Core.csproj" />
	</ItemGroup>

</Project>
