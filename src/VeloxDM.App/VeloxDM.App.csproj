<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is used only for the notification-area (tray) icon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VeloxDM</AssemblyName>
    <RootNamespace>VeloxDM.App</RootNamespace>
    <ApplicationIcon>Assets\velox.ico</ApplicationIcon>
    <!-- WPF0001: Fluent ThemeMode is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\velox.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VeloxDM.Core\VeloxDM.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
