<Window x:Class="VeloxDM.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/velox.ico" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Default download folder" FontWeight="SemiBold" />
        <DockPanel Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="Browse_Click" />
            <TextBox x:Name="FolderBox" />
        </DockPanel>

        <TextBlock Margin="0,18,0,0" FontWeight="SemiBold">
            <Run Text="Connections per download: " /><Run x:Name="ConnText" />
        </TextBlock>
        <Slider x:Name="ConnSlider" Minimum="1" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                ValueChanged="ConnSlider_ValueChanged" />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="More connections help on fast lines and slow servers. Some servers limit connections; VeloxDM backs off automatically." />

        <TextBlock Margin="0,18,0,0" FontWeight="SemiBold">
            <Run Text="Simultaneous downloads: " /><Run x:Name="ConcText" />
        </TextBlock>
        <Slider x:Name="ConcSlider" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                ValueChanged="ConcSlider_ValueChanged" />

        <TextBlock Text="Default video quality" FontWeight="SemiBold" Margin="0,18,0,0" />
        <ComboBox x:Name="QualityBox" Margin="0,6,0,0" DisplayMemberPath="Label" SelectedValuePath="Id" />

        <TextBlock Text="Video sign-in (age-restricted, private and members-only videos)" FontWeight="SemiBold" Margin="0,18,0,0" />
        <DockPanel Margin="0,6,0,0">
            <Button x:Name="SignOutButton" DockPanel.Dock="Right" Content="Sign out" Margin="8,0,0,0" Click="SignOut_Click" />
            <Button DockPanel.Dock="Right" Content="Sign in to YouTube..." Margin="8,0,0,0" Click="SignIn_Click" />
            <TextBlock x:Name="SignInStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
        <Expander Header="Other sign-in options" Margin="0,6,0,0">
            <StackPanel Margin="0,6,0,0">
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="Use cookies from a browser where you are signed in (works with Firefox; Chrome and Edge lock theirs), or a cookies.txt file exported with a browser extension." />
                <DockPanel Margin="0,6,0,0">
                    <TextBlock Text="Browser" Width="70" VerticalAlignment="Center" />
                    <ComboBox x:Name="BrowserBox" />
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock Text="File" Width="70" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="BrowseCookies_Click" />
                    <TextBox x:Name="CookiesBox" />
                </DockPanel>
            </StackPanel>
        </Expander>

        <CheckBox x:Name="ClipboardCheck" Margin="0,18,0,0" Content="Watch the clipboard for download and video links" />
        <CheckBox x:Name="TrayCheck" Margin="0,8,0,0" Content="Keep running in the notification area when closed or minimized" />
        <CheckBox x:Name="NotifyCheck" Margin="0,8,0,0" Content="Show a notification when a download finishes" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Save" IsDefault="True" MinWidth="90" Click="Save_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
