<Window x:Class="VeloxDM.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VeloxDM.App.Controls"
        Title="VeloxDM" Height="640" Width="1120" MinHeight="420" MinWidth="760"
        Icon="pack://application:,,,/Assets/velox.ico"
        WindowStartupLocation="CenterScreen" AllowDrop="True">
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="8,8,8,6">
            <WrapPanel>
                <Button Style="{StaticResource ToolButton}" Click="Add_Click" ToolTip="Add a URL (Ctrl+N)">
                    <StackPanel>
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Add URL" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Resume_Click" ToolTip="Start or resume selected">
                    <StackPanel>
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Resume" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Pause_Click" ToolTip="Pause selected">
                    <StackPanel>
                        <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Pause" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="ResumeAll_Click" ToolTip="Resume everything paused">
                    <StackPanel>
                        <TextBlock Text="&#xE8B3;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Start all" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="PauseAll_Click" ToolTip="Pause all downloads">
                    <StackPanel>
                        <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Stop all" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Delete_Click" ToolTip="Remove selected from the list (Del)">
                    <StackPanel>
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Remove" />
                    </StackPanel>
                </Button>
                <Border Width="1" Margin="8,6" Background="#30808080" />
                <Button Style="{StaticResource ToolButton}" Click="OpenFile_Click" ToolTip="Open file">
                    <StackPanel>
                        <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Open" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="OpenFolder_Click" ToolTip="Show in folder">
                    <StackPanel>
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Folder" />
                    </StackPanel>
                </Button>
                <Border Width="1" Margin="8,6" Background="#30808080" />
                <Button Style="{StaticResource ToolButton}" Click="Grabber_Click" ToolTip="Open a page and catch the video streams it plays (for blob: videos)">
                    <StackPanel>
                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Video grabber" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Tools_Click" ToolTip="Install or update yt-dlp, FFmpeg and Deno">
                    <StackPanel>
                        <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Video tools" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Settings_Click" ToolTip="Settings">
                    <StackPanel>
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="12,6" BorderThickness="0,1,0,0" BorderBrush="#30808080">
            <DockPanel>
                <TextBlock x:Name="ClipboardStatus" DockPanel.Dock="Right" Style="{StaticResource Muted}" />
                <TextBlock x:Name="StatusText" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Categories -->
            <ListBox x:Name="CategoryList" Margin="8,0,4,8" SelectionChanged="Category_Changed" BorderThickness="0" />

            <Grid Grid.Column="1" Margin="4,0,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                              HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False"
                              MouseDoubleClick="Grid_DoubleClick" SelectionChanged="Grid_SelectionChanged"
                              KeyDown="Grid_KeyDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="OpenFile_Click" />
                                <MenuItem Header="Show in folder" Click="OpenFolder_Click" />
                                <Separator />
                                <MenuItem Header="Resume" Click="Resume_Click" />
                                <MenuItem Header="Pause" Click="Pause_Click" />
                                <MenuItem Header="Download again" Click="Redownload_Click" />
                                <Separator />
                                <MenuItem Header="Copy URL" Click="CopyUrl_Click" />
                                <MenuItem Header="Remove from list" Click="Delete_Click" />
                                <MenuItem Header="Remove and delete file" Click="DeleteWithFile_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File name" Binding="{Binding FileName}" Width="3*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                            <DataGridTemplateColumn Header="Progress" Width="150" SortMemberPath="Progress">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,4">
                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" MinHeight="16" />
                                            <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Speed" Binding="{Binding SpeedText}" Width="95" SortMemberPath="Speed" />
                            <DataGridTextColumn Header="Time left" Binding="{Binding EtaText}" Width="80" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="2*" />
                            <DataGridTextColumn Header="Added" Binding="{Binding AddedText}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center" Style="{StaticResource Muted}" />
                        <TextBlock Text="Copy any download or video link, or press Add URL." Margin="0,10,0,0" Style="{StaticResource Muted}" />
                        <TextBlock Text="You can also drop links onto this window." HorizontalAlignment="Center" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Grid>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- Details for the selected download -->
                <Border Grid.Row="2" x:Name="Details" Padding="12" CornerRadius="6" Background="#14808080" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="DetailName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DetailUrl" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock x:Name="DetailPath" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                        <controls:SegmentBar x:Name="Segments" Height="14" Margin="0,10,0,4" />
                        <TextBlock x:Name="DetailInfo" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                        <Button x:Name="SignInButton" Content="Sign in to YouTube and retry" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Visibility="Collapsed" Click="SignIn_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

