<Window x:Class="VeloxDM.App.Views.GrabberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Video Grabber - VeloxDM" Width="1100" Height="820" MinWidth="700" MinHeight="500"
        Icon="pack://application:,,,/Assets/velox.ico" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Address bar -->
        <DockPanel DockPanel.Dock="Top" Margin="8">
            <Button DockPanel.Dock="Left" Content="&#xE72B;" FontFamily="{StaticResource IconFont}" ToolTip="Back" Click="Back_Click" Padding="10,4" />
            <Button DockPanel.Dock="Left" Content="&#xE72C;" FontFamily="{StaticResource IconFont}" ToolTip="Reload" Click="Reload_Click" Padding="10,4" Margin="4,0,8,0" />
            <Button DockPanel.Dock="Right" Content="Go" Click="Go_Click" MinWidth="60" Margin="8,0,0,0" />
            <TextBox x:Name="AddressBox" KeyDown="AddressBox_KeyDown" VerticalContentAlignment="Center" />
        </DockPanel>

        <!-- Detected streams -->
        <Border DockPanel.Dock="Bottom" Padding="10" BorderThickness="0,1,0,0" BorderBrush="#30808080">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Clear list" Click="Clear_Click" />
                    <TextBlock x:Name="HintText" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Open the video page and press Play. The real video streams behind the player appear here." />
                </DockPanel>
                <Border x:Name="DrmBanner" Margin="0,8,0,0" Padding="10,6" CornerRadius="6" Background="#22EF4444" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap"
                               Text="This page uses DRM (copy protection). Protected videos can't be downloaded; any unprotected streams below still work." />
                </Border>
                <ListView x:Name="StreamList" Height="170" Margin="0,8,0,0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Download" Click="Download_Click" Tag="{Binding}" Padding="10,2" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Type" Width="110" DisplayMemberBinding="{Binding Type}" />
                            <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding Size}" />
                            <GridViewColumn Header="Address" Width="720" DisplayMemberBinding="{Binding Url}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="StatusText" Margin="0,6,0,0" Style="{StaticResource Muted}" />
            </StackPanel>
        </Border>

        <wv2:WebView2 x:Name="Web" />
    </DockPanel>
</Window>
