<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <Product>BpstVideoDownloader</Product>
    <Company>BitProSoftTech</Company>
